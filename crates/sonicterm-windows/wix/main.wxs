<?xml version='1.0' encoding='windows-1252'?>
<!--
  SonicTerm Terminal — Windows installer (cargo-wix / Wix3).

  Builds an MSI that:
    - installs sonicterm-windows.exe under "Program Files\SonicTerm\"
    - bundles bundled assets (themes, keymaps, fonts, icons/exports) under
      [INSTALLDIR]\assets\ so the app finds its defaults at runtime
    - registers a Start-menu shortcut and an optional Desktop shortcut
    - uses assets/icons/exports/sonic.ico as the Add/Remove Programs icon

  Hand-edited from a `cargo wix init` template.
-->
<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>
    <Product
        Id='*'
        Name='SonicTerm'
        UpgradeCode='B9F8C0F4-1F4F-4F2E-AE3C-7A9D7D6E3F11'
        Manufacturer='SonicTerm'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package Id='*'
            Keywords='Installer'
            Description='SonicTerm Installer'
            Manufacturer='SonicTerm'
            InstallerVersion='450'
            Languages='1033'
            Compressed='yes'
            InstallScope='perMachine'
            SummaryCodepage='1252'/>

        <MajorUpgrade
            Schedule='afterInstallInitialize'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.'/>

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1'/>
        <Property Id='DiskPrompt' Value='SonicTerm Installation'/>

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='ProgramFiles64Folder' Name='PFiles'>
                <Directory Id='APPLICATIONFOLDER' Name='SonicTerm'>

                    <Component Id='binary0' Guid='8F8A7D4E-4F6A-4F2E-AE3C-7A9D7D6E3F22' Win64='yes'>
                        <File
                            Id='exe0'
                            Name='sonicterm-windows.exe'
                            DiskId='1'
                            Source='..\..\target\x86_64-pc-windows-msvc\release\sonicterm-windows.exe'
                            KeyPath='yes'/>
                    </Component>


                    <Component Id='script_progids' Guid='C1A21A01-0000-0000-0000-000000000105' Win64='yes'>
                        <RegistryValue Root='HKLM' Key='Software\Classes\SonicTerm.ps1' Type='string' Value='PowerShell Script' KeyPath='yes'/>
                        <RegistryValue Root='HKLM' Key='Software\Classes\SonicTerm.ps1' Name='FriendlyTypeName' Type='string' Value='PowerShell Script'/>
                        <RegistryValue Root='HKLM' Key='Software\Classes\SonicTerm.ps1\DefaultIcon' Type='string' Value='&quot;[APPLICATIONFOLDER]sonicterm-windows.exe&quot;,0'/>
                        <RegistryValue Root='HKLM' Key='Software\Classes\SonicTerm.ps1\shell\open\command' Type='string' Value='&quot;[APPLICATIONFOLDER]sonicterm-windows.exe&quot; --open-script &quot;%1&quot;'/>
                        <RemoveRegistryKey Id='RemoveSonicTermPs1ProgId' Root='HKLM' Key='Software\Classes\SonicTerm.ps1' Action='removeOnUninstall'/>
                        <RegistryValue Root='HKLM' Key='Software\Classes\SonicTerm.cmd' Type='string' Value='Windows Command Script'/>
                        <RegistryValue Root='HKLM' Key='Software\Classes\SonicTerm.cmd' Name='FriendlyTypeName' Type='string' Value='Windows Command Script'/>
                        <RegistryValue Root='HKLM' Key='Software\Classes\SonicTerm.cmd\DefaultIcon' Type='string' Value='&quot;[APPLICATIONFOLDER]sonicterm-windows.exe&quot;,0'/>
                        <RegistryValue Root='HKLM' Key='Software\Classes\SonicTerm.cmd\shell\open\command' Type='string' Value='&quot;[APPLICATIONFOLDER]sonicterm-windows.exe&quot; --open-script &quot;%1&quot;'/>
                        <RemoveRegistryKey Id='RemoveSonicTermCmdProgId' Root='HKLM' Key='Software\Classes\SonicTerm.cmd' Action='removeOnUninstall'/>
                        <RegistryValue Root='HKLM' Key='Software\Classes\SonicTerm.bat' Type='string' Value='Windows Batch File'/>
                        <RegistryValue Root='HKLM' Key='Software\Classes\SonicTerm.bat' Name='FriendlyTypeName' Type='string' Value='Windows Batch File'/>
                        <RegistryValue Root='HKLM' Key='Software\Classes\SonicTerm.bat\DefaultIcon' Type='string' Value='&quot;[APPLICATIONFOLDER]sonicterm-windows.exe&quot;,0'/>
                        <RegistryValue Root='HKLM' Key='Software\Classes\SonicTerm.bat\shell\open\command' Type='string' Value='&quot;[APPLICATIONFOLDER]sonicterm-windows.exe&quot; --open-script &quot;%1&quot;'/>
                        <RemoveRegistryKey Id='RemoveSonicTermBatProgId' Root='HKLM' Key='Software\Classes\SonicTerm.bat' Action='removeOnUninstall'/>
                        <RegistryValue Root='HKLM' Key='Software\Classes\SonicTerm.sh' Type='string' Value='Shell Script'/>
                        <RegistryValue Root='HKLM' Key='Software\Classes\SonicTerm.sh' Name='FriendlyTypeName' Type='string' Value='Shell Script'/>
                        <RegistryValue Root='HKLM' Key='Software\Classes\SonicTerm.sh\DefaultIcon' Type='string' Value='&quot;[APPLICATIONFOLDER]sonicterm-windows.exe&quot;,0'/>
                        <RegistryValue Root='HKLM' Key='Software\Classes\SonicTerm.sh\shell\open\command' Type='string' Value='&quot;[APPLICATIONFOLDER]sonicterm-windows.exe&quot; --open-script &quot;%1&quot;'/>
                        <RemoveRegistryKey Id='RemoveSonicTermShProgId' Root='HKLM' Key='Software\Classes\SonicTerm.sh' Action='removeOnUninstall'/>
                    </Component>

                    <Component Id='script_capabilities' Guid='C1A21A01-0000-0000-0000-000000000106' Win64='yes'>
                        <RegistryValue Root='HKLM' Key='Software\SonicTerm\SonicTerm\Capabilities' Name='ApplicationDescription' Type='string' Value='GPU-accelerated terminal for safely opening shell scripts' KeyPath='yes'/>
                        <RegistryValue Root='HKLM' Key='Software\SonicTerm\SonicTerm\Capabilities' Name='ApplicationName' Type='string' Value='SonicTerm'/>
                        <RegistryValue Root='HKLM' Key='Software\SonicTerm\SonicTerm\Capabilities' Name='ApplicationIcon' Type='string' Value='&quot;[APPLICATIONFOLDER]sonicterm-windows.exe&quot;,0'/>
                        <RegistryValue Root='HKLM' Key='Software\SonicTerm\SonicTerm\Capabilities\FileAssociations' Name='.ps1' Type='string' Value='SonicTerm.ps1'/>
                        <RegistryValue Root='HKLM' Key='Software\SonicTerm\SonicTerm\Capabilities\FileAssociations' Name='.cmd' Type='string' Value='SonicTerm.cmd'/>
                        <RegistryValue Root='HKLM' Key='Software\SonicTerm\SonicTerm\Capabilities\FileAssociations' Name='.bat' Type='string' Value='SonicTerm.bat'/>
                        <RegistryValue Root='HKLM' Key='Software\SonicTerm\SonicTerm\Capabilities\FileAssociations' Name='.sh' Type='string' Value='SonicTerm.sh'/>
                        <RegistryValue Root='HKLM' Key='Software\RegisteredApplications' Name='SonicTerm' Type='string' Value='Software\SonicTerm\SonicTerm\Capabilities'/>
                        <RemoveRegistryKey Id='RemoveSonicTermCapabilities' Root='HKLM' Key='Software\SonicTerm\SonicTerm\Capabilities' Action='removeOnUninstall'/>
                    </Component>

                    <Component Id='script_open_with' Guid='C1A21A01-0000-0000-0000-000000000107' Win64='yes'>
                        <RegistryValue Root='HKLM' Key='Software\Classes\.ps1\OpenWithProgids' Name='SonicTerm.ps1' Type='string' Value='' KeyPath='yes'/>
                        <RegistryValue Root='HKLM' Key='Software\Classes\.cmd\OpenWithProgids' Name='SonicTerm.cmd' Type='string' Value=''/>
                        <RegistryValue Root='HKLM' Key='Software\Classes\.bat\OpenWithProgids' Name='SonicTerm.bat' Type='string' Value=''/>
                        <RegistryValue Root='HKLM' Key='Software\Classes\.sh\OpenWithProgids' Name='SonicTerm.sh' Type='string' Value=''/>
                    </Component>

                    <Directory Id='AssetsDir' Name='assets'>
                        <Directory Id='AssetsThemesDir' Name='themes'>
                            <Component Id='asset_themes' Guid='C1A21A01-0000-0000-0000-000000000101' Win64='yes'>
                                <File Id='theme_catppuccin' Name='catppuccin-mocha.toml' DiskId='1' Source='..\..\assets\themes\catppuccin-mocha.toml' KeyPath='yes'/>
                                <File Id='theme_dracula'    Name='dracula.toml'          DiskId='1' Source='..\..\assets\themes\dracula.toml'/>
                                <File Id='theme_gruvbox'    Name='gruvbox-dark-hard.toml' DiskId='1' Source='..\..\assets\themes\gruvbox-dark-hard.toml'/>
                                <File Id='theme_monokai'    Name='monokai-pro.toml'      DiskId='1' Source='..\..\assets\themes\monokai-pro.toml'/>
                                <File Id='theme_nord'       Name='nord.toml'             DiskId='1' Source='..\..\assets\themes\nord.toml'/>
                                <File Id='theme_onedark'    Name='one-dark.toml'         DiskId='1' Source='..\..\assets\themes\one-dark.toml'/>
                                <File Id='theme_solarized'  Name='solarized-dark.toml'   DiskId='1' Source='..\..\assets\themes\solarized-dark.toml'/>
                                <File Id='theme_tokyo'      Name='tokyo-night.toml'      DiskId='1' Source='..\..\assets\themes\tokyo-night.toml'/>
                                <File Id='theme_wezterm'    Name='wezterm.toml'          DiskId='1' Source='..\..\assets\themes\wezterm.toml'/>
                            </Component>
                        </Directory>

                        <Directory Id='AssetsKeymapsDir' Name='keymaps'>
                            <Component Id='asset_keymaps' Guid='C1A21A01-0000-0000-0000-000000000102' Win64='yes'>
                                <File Id='keymap_sonicterm'         Name='sonicterm.toml'         DiskId='1' Source='..\..\assets\keymaps\sonicterm.toml' KeyPath='yes'/>
                                <File Id='keymap_sonicterm_macos'   Name='sonicterm-macos.toml'   DiskId='1' Source='..\..\assets\keymaps\sonicterm-macos.toml'/>
                                <File Id='keymap_sonicterm_windows' Name='sonicterm-windows.toml' DiskId='1' Source='..\..\assets\keymaps\sonicterm-windows.toml'/>
                                <File Id='keymap_sonicterm_linux'   Name='sonicterm-linux.toml'   DiskId='1' Source='..\..\assets\keymaps\sonicterm-linux.toml'/>
                            </Component>
                        </Directory>

                        <Directory Id='AssetsFontsDir' Name='fonts'>
                            <Component Id='asset_fonts' Guid='C1A21A01-0000-0000-0000-000000000103' Win64='yes'>
                                <File Id='font_regular'    Name='RecMonoSt.Helens-Regular.ttf'    DiskId='1' Source='..\..\assets\fonts\RecMonoSt.Helens-Regular.ttf' KeyPath='yes'/>
                                <File Id='font_bold'       Name='RecMonoSt.Helens-Bold.ttf'       DiskId='1' Source='..\..\assets\fonts\RecMonoSt.Helens-Bold.ttf'/>
                                <File Id='font_italic'     Name='RecMonoSt.Helens-Italic.ttf'     DiskId='1' Source='..\..\assets\fonts\RecMonoSt.Helens-Italic.ttf'/>
                                <File Id='font_bolditalic' Name='RecMonoSt.Helens-BoldItalic.ttf' DiskId='1' Source='..\..\assets\fonts\RecMonoSt.Helens-BoldItalic.ttf'/>
                            </Component>
                        </Directory>

                        <Directory Id='AssetsIconsDir' Name='icons'>
                            <Directory Id='AssetsIconsExportsDir' Name='exports'>
                                <Component Id='asset_icons' Guid='C1A21A01-0000-0000-0000-000000000104' Win64='yes'>
                                    <File Id='icon_ico'  Name='sonic.ico'  DiskId='1' Source='..\..\assets\icons\exports\sonic.ico' KeyPath='yes'/>
                                    <File Id='icon_icns' Name='sonic.icns' DiskId='1' Source='..\..\assets\icons\exports\sonic.icns'/>
                                </Component>
                            </Directory>
                        </Directory>
                    </Directory>
                </Directory>
            </Directory>

            <Directory Id='ProgramMenuFolder'>
                <Directory Id='ApplicationProgramsFolder' Name='SonicTerm'>
                    <Component Id='start_menu_shortcut' Guid='C1A21A01-0000-0000-0000-0000000000A1' Win64='yes'>
                        <Shortcut Id='StartMenuShortcut'
                            Name='SonicTerm'
                            Description='GPU-accelerated cross-platform terminal'
                            Target='[APPLICATIONFOLDER]sonicterm-windows.exe'
                            WorkingDirectory='APPLICATIONFOLDER'
                            Icon='ProductIcon'
                            IconIndex='0'/>
                        <RemoveFolder Id='RemoveApplicationProgramsFolder' On='uninstall'/>
                        <RegistryValue Root='HKCU' Key='Software\SonicTerm\SonicTerm' Name='installed' Type='integer' Value='1' KeyPath='yes'/>
                    </Component>
                </Directory>
            </Directory>

            <Directory Id='DesktopFolder' Name='Desktop'>
                <Component Id='desktop_shortcut' Guid='C1A21A01-0000-0000-0000-0000000000A2' Win64='yes'>
                    <Condition>INSTALLDESKTOPSHORTCUT=1</Condition>
                    <Shortcut Id='DesktopShortcut'
                        Name='SonicTerm'
                        Description='GPU-accelerated cross-platform terminal'
                        Target='[APPLICATIONFOLDER]sonicterm-windows.exe'
                        WorkingDirectory='APPLICATIONFOLDER'
                        Icon='ProductIcon'
                        IconIndex='0'/>
                    <RegistryValue Root='HKCU' Key='Software\SonicTerm\SonicTerm' Name='desktop_shortcut' Type='integer' Value='1' KeyPath='yes'/>
                </Component>
            </Directory>
        </Directory>

        <Feature Id='Binaries'
            Title='SonicTerm'
            Description='Installs all files.'
            Level='1'
            ConfigurableDirectory='APPLICATIONFOLDER'
            AllowAdvertise='no'
            Display='expand'
            Absent='disallow'>
            <ComponentRef Id='binary0'/>
            <ComponentRef Id='script_progids'/>
            <ComponentRef Id='script_capabilities'/>
            <ComponentRef Id='script_open_with'/>
            <ComponentRef Id='asset_themes'/>
            <ComponentRef Id='asset_keymaps'/>
            <ComponentRef Id='asset_fonts'/>
            <ComponentRef Id='asset_icons'/>
            <ComponentRef Id='start_menu_shortcut'/>
            <ComponentRef Id='desktop_shortcut'/>
        </Feature>


        <CustomAction Id='RollbackRefreshShellAssociationsInstall'
            FileKey='exe0'
            ExeCommand='--refresh-shell-associations'
            Execute='rollback'
            Impersonate='yes'
            Return='ignore'/>
        <CustomAction Id='RefreshShellAssociationsInstall'
            FileKey='exe0'
            ExeCommand='--refresh-shell-associations'
            Execute='deferred'
            Impersonate='yes'
            Return='ignore'/>
        <CustomAction Id='RollbackRefreshShellAssociationsUninstall'
            FileKey='exe0'
            ExeCommand='--refresh-shell-associations'
            Execute='rollback'
            Impersonate='yes'
            Return='ignore'/>
        <CustomAction Id='RefreshShellAssociationsUninstall'
            FileKey='exe0'
            ExeCommand='--refresh-shell-associations'
            Execute='deferred'
            Impersonate='yes'
            Return='ignore'/>

        <InstallExecuteSequence>
            <Custom Action='RollbackRefreshShellAssociationsInstall' After='WriteRegistryValues'>NOT Installed</Custom>
            <Custom Action='RefreshShellAssociationsInstall' After='RollbackRefreshShellAssociationsInstall'>NOT Installed</Custom>
            <Custom Action='RollbackRefreshShellAssociationsUninstall' After='RemoveRegistryValues'>REMOVE=&quot;ALL&quot;</Custom>
            <Custom Action='RefreshShellAssociationsUninstall' After='RollbackRefreshShellAssociationsUninstall'>REMOVE=&quot;ALL&quot;</Custom>
        </InstallExecuteSequence>

        <Property Id='INSTALLDESKTOPSHORTCUT' Value='1'/>
        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>

        <Icon Id='ProductIcon' SourceFile='..\..\assets\icons\exports\sonic.ico'/>
        <Property Id='ARPPRODUCTICON' Value='ProductIcon'/>
        <Property Id='ARPHELPLINK' Value='https://github.com/D0n9X1n/SonicTerm'/>

        <UI>
            <UIRef Id='WixUI_FeatureTree'/>
        </UI>
    </Product>
</Wix>
